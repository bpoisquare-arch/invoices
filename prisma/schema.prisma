// 10. EMPLOYEES
model Employee {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  userId              String?  @map("user_id") @db.VarChar(36)
  employeeId          String   @unique(map: "unique_employee_id") @map("employee_id") @db.VarChar(50)
  name                String   @db.VarChar(255)
  normalizedName      String   @map("normalized_name") @db.VarChar(255)
  designation         String   @db.VarChar(255)
  email               String?  @db.VarChar(255)
  branch              String?  @default("Multan") @db.VarChar(100)
  salary              Decimal? @db.Decimal(12, 2)
  joiningDate         DateTime? @map("joining_date") @db.Date
  isOldStaff          Boolean  @default(false) @map("is_old_staff")
  isAttendanceExempt  Boolean  @default(false) @map("is_attendance_exempt")
  leaveQuotas         Json?    @map("leave_quotas")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  attendanceRecords   AttendanceRecord[]
  attendanceRequests  AttendanceRequest[]

  @@index([normalizedName], map: "idx_employees_normalized_name")
  @@index([employeeId], map: "idx_employees_employee_id")
  @@index([isActive], map: "idx_employees_is_active")
  @@map("employees")
}

// 11. EMPLOYEE SEQUENCES
model EmployeeSequence {
  id         Int    @id @default(1)
  lastNumber BigInt @default(0) @map("last_number")

  @@map("employee_sequences")
}

// 12. ATTENDANCE SETTINGS
model AttendanceSetting {
  id                   String   @id @default("default") @db.VarChar(50)
  weekdayInTime        String   @default("10:30") @map("weekday_in_time") @db.VarChar(10)
  weekdayGraceMinutes  Int      @default(15) @map("weekday_grace_minutes")
  weekdayOutTime       String   @default("18:30") @map("weekday_out_time") @db.VarChar(10)
  saturdayInTime       String   @default("11:00") @map("saturday_in_time") @db.VarChar(10)
  saturdayGraceMinutes Int      @default(15) @map("saturday_grace_minutes")
  saturdayOutTime      String   @default("15:00") @map("saturday_out_time") @db.VarChar(10)
  timezone             String   @default("Asia/Karachi") @db.VarChar(100)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("attendance_settings")
}

// 13. ATTENDANCE RECORDS
model AttendanceRecord {
  id                         String   @id @default(uuid()) @db.VarChar(36)
  employeeId                 String   @map("employee_id") @db.VarChar(36)
  attendanceDate             DateTime @map("attendance_date") @db.Date
  dayOfWeek                  String   @map("day_of_week") @db.VarChar(20)
  inTime                     String?  @map("in_time") @db.VarChar(20)
  outTime                    String?  @map("out_time") @db.VarChar(20)
  arrivalStatus              String   @map("arrival_status") @db.VarChar(50)
  departureStatus            String   @map("departure_status") @db.VarChar(50)
  totalWorkingMinutes        Int      @default(0) @map("total_working_minutes")
  totalWorkingHoursFormatted String   @default("0h 0m") @map("total_working_hours_formatted") @db.VarChar(50)
  rawPunches                 Json     @map("raw_punches")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, attendanceDate], map: "unique_employee_attendance_date")
  @@index([employeeId], map: "idx_attendance_records_employee_id")
  @@index([attendanceDate], map: "idx_attendance_records_date")
  @@map("attendance_records")
}

// 14. ATTENDANCE REQUESTS
model AttendanceRequest {
  id               String    @id @default(uuid()) @db.VarChar(36)
  employeeId       String    @map("employee_id") @db.VarChar(36)
  employeeName     String    @map("employee_name") @db.VarChar(255)
  batchId          String    @map("batch_id") @db.VarChar(50)
  branch           String    @default("Multan") @db.VarChar(100)
  attendanceDate   DateTime  @map("attendance_date") @db.Date
  requestType      String    @map("request_type") @db.VarChar(50)
  leaveType        String?   @map("leave_type") @db.VarChar(50)
  leaveDuration    Decimal?  @default(1.0) @map("leave_duration") @db.Decimal(4, 2)
  requestedInTime  String?   @map("requested_in_time") @db.VarChar(20)
  requestedOutTime String?   @map("requested_out_time") @db.VarChar(20)
  reason           String?   @db.Text
  status           String    @default("PENDING") @db.VarChar(50)
  submittedBy      String    @map("submitted_by") @db.VarChar(100)
  reviewedBy       String?   @map("reviewed_by") @db.VarChar(100)
  reviewedAt       DateTime? @map("reviewed_at")
  reviewNotes      String?   @map("review_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, attendanceDate], map: "idx_att_requests_emp_date")
  @@index([status], map: "idx_att_requests_status")
  @@index([branch], map: "idx_att_requests_branch")
  @@map("attendance_requests")
}

// 15. ATTENDANCE AUDIT LOGS
model AttendanceAuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  action    String   @db.VarChar(50)
  details   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_attendance_audit_logs_created_at")
  @@map("attendance_audit_logs")
}

// 16. GAZETTED HOLIDAYS
model GazettedHoliday {
  id        String   @id @default(uuid()) @db.VarChar(36)
  date      DateTime @unique(map: "unique_gazetted_date") @db.Date
  name      String   @default("Gazetted Holiday") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("gazetted_holidays")
}

// 17. EMPLOYEE COMMISSIONS
model EmployeeCommission {
  id         String   @id @db.VarChar(255)
  employeeId String   @map("employee_id") @db.VarChar(100)
  monthYear  String   @map("month_year") @db.VarChar(20)
  amount     Decimal  @default(0.00) @db.Decimal(12, 2)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([employeeId, monthYear], map: "unique_emp_month_commission")
  @@index([employeeId, monthYear], map: "idx_employee_commissions_lookup")
  @@map("employee_commissions")
}

// 18. EMPLOYEE DEDUCTIONS
model EmployeeDeduction {
  id         String   @id @db.VarChar(255)
  employeeId String   @map("employee_id") @db.VarChar(100)
  monthYear  String   @map("month_year") @db.VarChar(20)
  amount     Decimal  @default(0.00) @db.Decimal(12, 2)
  noteType   String?  @default("Other Deduction") @map("note_type") @db.VarChar(100)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([employeeId, monthYear], map: "unique_emp_month_deduction")
  @@index([employeeId, monthYear], map: "idx_employee_deductions_lookup")
  @@map("employee_deductions")
}

// 19. EMPLOYEE ADJUSTMENTS
model EmployeeAdjustment {
  id         String   @id @db.VarChar(255)
  employeeId String   @map("employee_id") @db.VarChar(100)
  monthYear  String   @map("month_year") @db.VarChar(20)
  amount     Decimal  @default(0.00) @db.Decimal(12, 2)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([employeeId, monthYear], map: "unique_emp_month_adjustment")
  @@index([employeeId, monthYear], map: "idx_employee_adjustments_lookup")
  @@map("employee_adjustments")
}

