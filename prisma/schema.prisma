generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. COMPANIES
model Company {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.Text
  prefix    String   @db.VarChar(20)
  currency  String   @default("AUD") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sequence  CompanySequence?
  templates Template[]
  invoices  Invoice[]

  @@map("companies")
}

// 2. COMPANY SEQUENCES
model CompanySequence {
  companyId  String  @id @map("company_id") @db.VarChar(36)
  lastNumber BigInt  @default(0) @map("last_number")
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_sequences")
}

// 3. TEMPLATES
model Template {
  id             String   @id @default(uuid()) @db.VarChar(36)
  companyId      String   @map("company_id") @db.VarChar(36)
  name           String   @db.VarChar(255)
  companyName    String   @map("company_name") @db.VarChar(255)
  address        String?  @db.Text
  phone          String?  @db.VarChar(100)
  email          String?  @db.VarChar(255)
  paymentDetails String?  @map("payment_details") @db.Text
  bankDetails    String?  @map("bank_details") @db.Text
  currency       String?  @default("AUD") @db.VarChar(10)
  footerTerms    String?  @map("footer_terms") @db.Text
  primaryColor   String?  @default("#2563eb") @map("primary_color") @db.VarChar(20)
  layoutType     String?  @default("edlink_v1") @map("layout_type") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([companyId], map: "idx_templates_company_id")
  @@map("templates")
}

// 4. INVOICES
model Invoice {
  id               String   @id @default(uuid()) @db.VarChar(36)
  userId           String?  @map("user_id") @db.VarChar(36)
  companyId        String   @map("company_id") @db.VarChar(36)
  templateId       String?  @map("template_id") @db.VarChar(36)
  templateSnapshot Json     @map("template_snapshot")
  invoiceNumber    String   @unique(map: "unique_invoice_number") @map("invoice_number") @db.VarChar(50)
  referenceName    String?  @map("reference_name") @db.VarChar(255)
  customerName     String   @map("customer_name") @db.VarChar(255)
  invoiceDate      DateTime @map("invoice_date") @db.Date
  dueDate          DateTime @map("due_date") @db.Date
  subtotal         Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal  @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  template Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]

  @@index([companyId], map: "idx_invoices_company_id")
  @@index([customerName], map: "idx_invoices_customer_name")
  @@index([createdAt], map: "idx_invoices_created_at")
  @@map("invoices")
}

// 5. INVOICE ITEMS
model InvoiceItem {
  id          String   @id @default(uuid()) @db.VarChar(36)
  invoiceId   String   @map("invoice_id") @db.VarChar(36)
  description String   @db.Text
  quantity    Decimal  @default(1.00) @db.Decimal(10, 2)
  amount      Decimal  @default(0.00) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0.00) @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_invoice_items_invoice_id")
  @@map("invoice_items")
}

// 6. INSTALLMENT SCHEDULES
model InstallmentSchedule {
  id                     String    @id @db.VarChar(255)
  userId                 String?   @map("user_id") @db.VarChar(36)
  date                   DateTime  @db.Date
  studentName            String    @map("student_name") @db.VarChar(255)
  studentId              String    @map("student_id") @db.VarChar(100)
  courseName             String    @map("course_name") @db.VarChar(255)
  duration               String    @db.VarChar(100)
  startDate              DateTime  @map("start_date") @db.Date
  endDate                DateTime  @map("end_date") @db.Date
  startMonthYear         String?   @map("start_month_year") @db.VarChar(20)
  endMonthOffset         Int?      @default(3) @map("end_month_offset")
  adminFee               Decimal   @default(0.00) @map("admin_fee") @db.Decimal(12, 2)
  resourcesFee           Decimal   @default(0.00) @map("resources_fee") @db.Decimal(12, 2)
  materialFee            Decimal?  @default(0.00) @map("material_fee") @db.Decimal(12, 2)
  tuitionFee             Decimal   @default(0.00) @map("tuition_fee") @db.Decimal(12, 2)
  scholarship            Decimal   @default(0.00) @db.Decimal(12, 2)
  totalAmount            Decimal   @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  firstInstallmentAmount Decimal   @default(0.00) @map("first_installment_amount") @db.Decimal(12, 2)
  scheduleItems          Json      @map("schedule_items")
  recipientEmail         String?   @map("recipient_email") @db.VarChar(255)
  fromEmail              String?   @map("from_email") @db.VarChar(255)
  emailSubject           String?   @map("email_subject") @db.Text
  emailMessage           String?   @map("email_message") @db.Text
  lastEmailSentAt        DateTime? @map("last_email_sent_at")
  lastEmailStatus        String?   @map("last_email_status") @db.VarChar(50)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([studentId], map: "idx_installment_schedules_student_id")
  @@map("installment_schedules")
}

// 7. INSTALLMENT EMAIL LOGS
model InstallmentEmailLog {
  id                String    @id @default(uuid()) @db.VarChar(36)
  scheduleId        String    @map("schedule_id") @db.VarChar(255)
  fromEmail         String    @map("from_email") @db.VarChar(255)
  toEmail           String    @map("to_email") @db.VarChar(255)
  subject           String    @db.Text
  message           String?   @db.Text
  emailType         String    @map("email_type") @db.VarChar(20)
  resendNumber      Int       @default(0) @map("resend_number")
  status            String    @db.VarChar(20)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(255)
  sentAt            DateTime  @default(now()) @map("sent_at")
  errorMessage      String?   @map("error_message") @db.Text
  nextResendAt      DateTime? @map("next_resend_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([scheduleId], map: "idx_installment_email_logs_schedule_id")
  @@index([sentAt], map: "idx_installment_email_logs_sent_at")
  @@map("installment_email_logs")
}

