  endMonthOffset         Int?      @default(3) @map("end_month_offset")
  adminFee               Decimal   @default(0.00) @map("admin_fee") @db.Decimal(12, 2)
  resourcesFee           Decimal   @default(0.00) @map("resources_fee") @db.Decimal(12, 2)
  materialFee            Decimal?  @default(0.00) @map("material_fee") @db.Decimal(12, 2)
  tuitionFee             Decimal   @default(0.00) @map("tuition_fee") @db.Decimal(12, 2)
  scholarship            Decimal   @default(0.00) @db.Decimal(12, 2)
